---
import background from '../assets/topbanner_2026.png';
import bottom from '../assets/bottombanner_2026.png';
---


<main id="top" class="flex flex-col items-center w-full">
<img id="background-top" src={background.src} alt="top-banner depicting norwegian flags and" fetchpriority="high" class="w-full" />

	 <header class="relative flex flex-col items-center w-full uppercase mx-5">
         <h1 class="absolute font-bold sm:text-2xl"><span class="text-4xl sm:text-5xl">Jo</span>Alexander</h1>
		<h1 class="absolute font-extralight text-sm mt-[3px] -ml-[44px] sm:-ml-34">Vigdis gifter seg!</h1>
		<h1 class="absolute font-bold text-3xl sm:text-5xl -top-[10px] sm:-top-6 ml-[188px] sm:ml-66">Det er sant!</h1>
    </header>
    <nav class="flex flex-col w-full items-center mt-20">
        <a href="#prog" class="py-1 text-center mb-1 w-full bg-gray-200 hover:bg-blue-700 text-black hover:text-white font-light hover:font-bold transition-all ease-linear duration-100">PROGRAM</a>
<!--         <a href="#sang1" class="py-1 text-center mb-1 w-full bg-gray-200 hover:bg-blue-700 text-black hover:text-white font-light hover:font-bold transition-all ease-linear duration-100">JA VI ELSKER</a>
        <a href="#sang2" class="py-1 text-center mb-1 w-full bg-gray-200 hover:bg-blue-700 text-black hover:text-white font-light hover:font-bold transition-all ease-linear duration-100">NORGE I RØDT, HVITT OG BLÅTT</a> -->
        <a href="#kart" class="py-1 text-center mb-1 w-full bg-gray-200 hover:bg-blue-700 text-black hover:text-white font-light hover:font-bold transition-all ease-linear duration-100">KOR E BAREN!?</a></nav>
    <section id="prog" class="mt-10 max-w-[55ch] mx-10">
        <h2 class="font-bold text-2xl uppercase mb-2">Program for dagen</h2>
        <div class="flex mb-5">
            <h3 class="mr-2 font-bold">08:00</h3>
            <p>Første pels jækkes, spritn e på kok</p>
        </div>
        <div class="flex mb-5">
            <h3 class="mr-2 font-bold">11:30</h3>
            <p>Dæm fullaste har blir hænta av heimeværent og kjørt te kjærka. Det e tomt for himert ...</p>
        </div>
        <div class="flex mb-5">
            <h3 class="mr-2 font-bold">11:45</h3>
            <p>Ny himert e satt på kok</p>
        </div>
        <div class="flex mb-5">
            <h3 class="mr-2 font-bold">12:00</h3>
            <p>Tomt for drekka i baren</p>
        </div>
        <div class="flex mb-5">
            <h3 class="mr-2 font-bold">12:45</h3>
            <p>Ræsten av fyllesvinan kjøræs te kjærka å bindes fast i bænkan.</p>
        </div>
        <div class="flex mb-5">
            <h3 class="mr-2 font-bold">13:00</h3>
            <p>Præstn præke</p>
        </div>
        <div class="flex mb-5">
            <h3 class="mr-2 font-bold">13:15</h3>
            <p>Vigdis og Jo Alexander nikke mot kvarajnner med blanke aua (J***vlig trøkk i den himertn!)</p>
        </div>
        <div class="flex mb-5">
            <h3 class="mr-2 font-bold">14:30</h3>
            <p>Dagen avsluttes med den tradisjonelle allsangen.</p>
        </div>
    </section>
